# Public values. These are embedded in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin encoded in new demo QR codes. Use the preview or production URL.
APP_BASE_URL=http://localhost:3000

# Staff bootstrap. Do not commit real values. The password is passed only through the environment.
ALLOW_STAFF_BOOTSTRAP=false
STAFF_BOOTSTRAP_SECRET=replace-with-at-least-24-random-characters
STAFF_EMAIL=
STAFF_PASSWORD=
STAFF_DISPLAY_NAME=Demo staff

# Demo reset. Leave disabled until you intend to delete demonstration bookings.
DEMO_RESET_ENABLED=false
DEMO_RESET_ALLOW_PRODUCTION=false
